{
  "id": "com.astracut.premiere.panel",
  "name": "AstraCut — AI Editing Assistant",
  "version": "1.0.0",
  "main": "index.html",
  "host": [
    {
      "app": "PPRO",
      "minVersion": "22.0"
    }
  ],
  "entrypoints": [
    {
      "type": "panel",
      "id": "astracut.mainPanel",
      "label": {
        "default": "AstraCut AI Assistant"
      },
      "minimumSize": {
        "width": 380,
        "height": 500
      },
      "maximumSize": {
        "width": 1200,
        "height": 1600
      },
      "preferredDockedSize": {
        "width": 420,
        "height": 720
      }
    }
  ],
  "permissions": {
    "network": {
      "domains": [
        "https://generativelanguage.googleapis.com",
        "http://localhost:5000",
        "http://127.0.0.1:5000"
      ]
    },
    "localFileSystem": "fullAccess",
    "launchProcess": {
      "extensions": [".wav", ".mp4", ".mov", ".prproj"]
    }
  }
}
